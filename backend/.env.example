# ============================================================
# NovaSight backend — example environment configuration
# Copy to .env and fill in real values. Never commit .env.
# All secrets must use SecretStr fields — placeholders only here.
# ============================================================

# Application
ENVIRONMENT=local                # local | onprem | cloud
LOG_LEVEL=INFO

# Postgres (control-plane DB)
POSTGRES__HOST=localhost
POSTGRES__PORT=5432
POSTGRES__USER=novasight
POSTGRES__PASSWORD=<replace-me>
POSTGRES__DB=control_plane

# Redis
REDIS__HOST=localhost
REDIS__PORT=6379
REDIS__DB=0

# Object store (S3-compatible; MinIO for local/on-prem, S3 in cloud)
OBJECT_STORE__ENDPOINT_URL=http://localhost:9000   # leave blank for native AWS S3
OBJECT_STORE__REGION=us-east-1
OBJECT_STORE__ACCESS_KEY=<replace-me>
OBJECT_STORE__SECRET_KEY=<replace-me>
OBJECT_STORE__BUCKET=novasight-data
# Server-side (at-rest) encryption requested on every write. "AES256" = SSE-S3,
# "aws:kms" = SSE-KMS. Omit to rely on a bucket default-encryption policy instead.
# OBJECT_STORE__SERVER_SIDE_ENCRYPTION=AES256

# Iceberg REST catalog
ICEBERG__CATALOG_URI=http://localhost:19120/api/v1
ICEBERG__WAREHOUSE=s3://novasight-data/warehouse
# ICEBERG__CATALOG_TOKEN=<replace-me>   # optional bearer token; omit for open catalogs

# ClickHouse (serving engine)
CLICKHOUSE__HOST=localhost
CLICKHOUSE__PORT=8123
CLICKHOUSE__USER=default
CLICKHOUSE__PASSWORD=<replace-me>

# AI gateway
AI__PROVIDER=anthropic            # anthropic | openai | azure
AI__MODEL=<replace-me>            # e.g. claude-3-5-sonnet-20241022
AI__API_KEY=<replace-me>
AI__TEMPERATURE=0.0
AI__MAX_TOKENS=1024
AI__PROMPT_TEMPLATE_DIR=/app/ai/prompts

# ---------------------------------------------------------------------------
# Auth
#
# Two modes are supported:
#
#   OIDC mode (production default, dev_stub=false):
#     RS256 tokens verified against the OIDC provider's JWKS endpoint.
#     Set oidc_issuer, oidc_audience, jwks_url; leave dev_stub unset (defaults false).
#
#   Dev-stub mode (local development ONLY, dev_stub=true):
#     HS256 tokens verified with a shared secret. NEVER enable in production.
#     Set dev_stub=true and dev_stub_secret to any sufficiently long random string.
#
# AUTH__TENANT_CLAIM is the JWT claim name carrying the tenant slug.
# ---------------------------------------------------------------------------

# OIDC mode (set these for production / staging)
AUTH__OIDC_ISSUER=https://auth.example.com/realms/novasight
AUTH__OIDC_AUDIENCE=novasight-api
AUTH__JWKS_URL=https://auth.example.com/realms/novasight/protocol/openid-connect/certs

# Dev-stub mode (local only — NEVER set dev_stub=true in production)
AUTH__DEV_STUB=false
AUTH__DEV_STUB_SECRET=<replace-with-long-random-secret-32+chars>   # required only when dev_stub=true

# Password mode (self-contained login — the backend issues + verifies HS256 tokens).
# Set AUTH__SESSION_SECRET (with dev_stub=false and OIDC left blank) to enable the
# /auth/login flow. This is the default out-of-the-box mode for a single deployment.
AUTH__SESSION_SECRET=<replace-with-long-random-secret-32+chars>
# Token lifetimes in seconds (safe defaults; override if needed).
# AUTH__ACCESS_TTL_SECONDS=3600
# AUTH__REFRESH_TTL_SECONDS=1209600

# JWT claim name that carries the tenant identifier (default: "tenant")
AUTH__TENANT_CLAIM=tenant

# JWT claim name carrying the principal's roles (default: "roles"). Used to gate
# access to decrypted sensitive columns (see ENCRYPTION__SENSITIVE_VIEW_ROLE).
AUTH__ROLES_CLAIM=roles

# Role a principal must hold (in the roles claim) to operate the control plane —
# provisioning / de-provisioning tenants (default: "platform_admin"). This is a
# PLATFORM role, not a tenant role; control-plane endpoints are not tenant-scoped.
# AUTH__PLATFORM_ADMIN_ROLE=platform_admin

# Tenant-scoped role a user must hold to create/run/schedule pipelines and dbt jobs
# within their own tenant (default: "superuser"). A platform admin is implicitly allowed.
# AUTH__TENANT_SUPERUSER_ROLE=superuser

# ---------------------------------------------------------------------------
# Seed / bootstrap tenant
# The seed script creates this tenant on first run. Slug is immutable once set.
# ---------------------------------------------------------------------------
SEED_TENANT__SLUG=local
SEED_TENANT__NAME=Local Tenant
SEED_TENANT__ADMIN_EMAIL=admin@local.test
# Password for the seeded admin (password mode). When set, the admin can log in and
# is granted the platform-admin + tenant-superuser roles. Omit in OIDC mode.
SEED_TENANT__ADMIN_PASSWORD=<replace-with-a-strong-admin-password>

# ---------------------------------------------------------------------------
# Reporting worker (Phase 5)
#
# SMTP relay for emailing scheduled reports. The whole SMTP__* group is OPTIONAL:
# omit it entirely if you don't run scheduled reports. If you set any SMTP__* var,
# SMTP__HOST and SMTP__FROM_ADDRESS are required (the worker fails closed otherwise).
# Per-report schedule and recipients are NOT here — they live in the
# report_definitions registry, one row per tenant report.
# ---------------------------------------------------------------------------
# SMTP__HOST=smtp.example.com
# SMTP__PORT=587
# SMTP__USERNAME=apikey                # omit for relays that need no auth
# SMTP__PASSWORD=<replace-me>
# SMTP__USE_TLS=true
# SMTP__FROM_ADDRESS=reports@example.com
# SMTP__TLS_VERIFY=true                # verify the relay's TLS cert (keep true)
# SMTP__CA_BUNDLE=/etc/ssl/certs/internal-ca.pem   # CA file for a self-signed on-prem relay

# Reporting conventions (safe defaults shown; override only if needed)
# REPORTING__STORAGE_PREFIX=reports     # object-store key prefix, under the tenant namespace
# REPORTING__DISPATCH_CRON=* * * * *    # periodiq heartbeat that scans for due reports
# REPORTING__MAX_ROWS=100000            # row cap per workbook
# REPORTING__SUBJECT_PREFIX=[NovaSight]

# KPI alerts (Phase 5.2). Per-KPI threshold/schedule/channel/recipients live in the
# kpi_thresholds registry; email delivery reuses the SMTP__* relay above.
# ALERTS__DISPATCH_CRON=* * * * *           # periodiq heartbeat that scans for due KPIs
# ALERTS__WEBHOOK_TIMEOUT_SECONDS=10
# ALERTS__SUBJECT_PREFIX=[NovaSight][ALERT]

# ---------------------------------------------------------------------------
# Column-level encryption (Phase 5.4)
#
# Required only once a dataset tags a column sensitive. The provider abstracts the
# key authority; "local" keeps a symmetric master key here (dev / on-prem), cloud
# deployments select a KMS-backed provider. For the local provider, ENCRYPTION__KEY
# is a base64-encoded 32-byte AES key, e.g. generate with:
#   python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
# ---------------------------------------------------------------------------
# ENCRYPTION__PROVIDER=local
# ENCRYPTION__KEY=<replace-with-base64-32-byte-key>
# ENCRYPTION__SENSITIVE_VIEW_ROLE=sensitive_viewer   # role required to see decrypted values

# ---------------------------------------------------------------------------
# Catalog & lineage — OpenMetadata (Phase 5.3)
#
# Read by the catalog_metadata Dagster asset (data-platform/orchestration) and the
# OpenMetadata services in the compose stack. HOST_PORT and JWT_TOKEN point at
# deployment infrastructure (no defaults in code); SERVICE_NAME is a stable
# convention. The compose-only ports/DB knobs have safe defaults.
# ---------------------------------------------------------------------------
# OPENMETADATA__HOST_PORT=http://openmetadata-server:8585/api   # OM REST API base
# OPENMETADATA__JWT_TOKEN=<ingestion-bot-jwt>                   # from the OM UI: Settings → Bots
# OPENMETADATA__SERVICE_NAME=novasight_clickhouse              # OM service entity for ClickHouse
# Compose-only knobs (safe defaults shown):
# OPENMETADATA__DB=openmetadata          # dedicated database on the stack's Postgres
# OPENMETADATA__SERVER_PORT=8585
# OPENMETADATA__SERVER_ADMIN_PORT=8586
# OPENMETADATA__ES_PORT=9200
# OPENMETADATA__SERVER_URL=http://openmetadata-server:8585/api

# ---------------------------------------------------------------------------
# Observability — metrics + tracing (Phase 6.4)
#
# Metrics are on by default; the API serves them at OBSERVABILITY__METRICS_PATH and
# workers expose them on OBSERVABILITY__WORKER_METRICS_PORT (Dramatiq's exporter).
# Tracing stays OFF until both TRACING_ENABLED=true AND an OTLP endpoint are set
# (golden rule 1: the exporter endpoint comes from the environment, never code).
# ---------------------------------------------------------------------------
# OBSERVABILITY__METRICS_ENABLED=true
# OBSERVABILITY__METRICS_PATH=/metrics
# OBSERVABILITY__WORKER_METRICS_PORT=9100
# OBSERVABILITY__TRACING_ENABLED=false
# OBSERVABILITY__OTLP_ENDPOINT=http://jaeger:4318        # OTLP/HTTP base URL (collector/Jaeger)
# OBSERVABILITY__SERVICE_NAME=novasight
# OBSERVABILITY__TRACE_SAMPLE_RATIO=1.0
