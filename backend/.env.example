# ============================================================
# Analytica backend — example environment configuration
# Copy to .env and fill in real values. Never commit .env.
# All secrets must use SecretStr fields — placeholders only here.
# ============================================================

# Application
ENVIRONMENT=local                # local | onprem | cloud
LOG_LEVEL=INFO

# Postgres (control-plane DB)
POSTGRES__HOST=localhost
POSTGRES__PORT=5432
POSTGRES__USER=analytica
POSTGRES__PASSWORD=<replace-me>
POSTGRES__DB=control_plane

# Redis
REDIS__HOST=localhost
REDIS__PORT=6379
REDIS__DB=0

# Object store (S3-compatible; MinIO for local/on-prem, S3 in cloud)
OBJECT_STORE__ENDPOINT_URL=http://localhost:9000   # leave blank for native AWS S3
OBJECT_STORE__REGION=us-east-1
OBJECT_STORE__ACCESS_KEY=<replace-me>
OBJECT_STORE__SECRET_KEY=<replace-me>
OBJECT_STORE__BUCKET=analytica-data

# Iceberg REST catalog
ICEBERG__CATALOG_URI=http://localhost:19120/api/v1
ICEBERG__WAREHOUSE=s3://analytica-data/warehouse
# ICEBERG__CATALOG_TOKEN=<replace-me>   # optional bearer token; omit for open catalogs

# ClickHouse (serving engine)
CLICKHOUSE__HOST=localhost
CLICKHOUSE__PORT=8123
CLICKHOUSE__USER=default
CLICKHOUSE__PASSWORD=<replace-me>

# AI gateway
AI__PROVIDER=anthropic            # anthropic | openai | azure
AI__MODEL=<replace-me>            # e.g. claude-3-5-sonnet-20241022
AI__API_KEY=<replace-me>
AI__TEMPERATURE=0.0
AI__MAX_TOKENS=1024
AI__PROMPT_TEMPLATE_DIR=/app/ai/prompts

# ---------------------------------------------------------------------------
# Auth
#
# Two modes are supported:
#
#   OIDC mode (production default, dev_stub=false):
#     RS256 tokens verified against the OIDC provider's JWKS endpoint.
#     Set oidc_issuer, oidc_audience, jwks_url; leave dev_stub unset (defaults false).
#
#   Dev-stub mode (local development ONLY, dev_stub=true):
#     HS256 tokens verified with a shared secret. NEVER enable in production.
#     Set dev_stub=true and dev_stub_secret to any sufficiently long random string.
#
# AUTH__TENANT_CLAIM is the JWT claim name carrying the tenant slug.
# ---------------------------------------------------------------------------

# OIDC mode (set these for production / staging)
AUTH__OIDC_ISSUER=https://auth.example.com/realms/analytica
AUTH__OIDC_AUDIENCE=analytica-api
AUTH__JWKS_URL=https://auth.example.com/realms/analytica/protocol/openid-connect/certs

# Dev-stub mode (local only — NEVER set dev_stub=true in production)
AUTH__DEV_STUB=false
AUTH__DEV_STUB_SECRET=<replace-with-long-random-secret-32+chars>   # required only when dev_stub=true

# JWT claim name that carries the tenant identifier (default: "tenant")
AUTH__TENANT_CLAIM=tenant

# ---------------------------------------------------------------------------
# Seed / bootstrap tenant
# The seed script creates this tenant on first run. Slug is immutable once set.
# ---------------------------------------------------------------------------
SEED_TENANT__SLUG=local
SEED_TENANT__NAME=Local Tenant
SEED_TENANT__ADMIN_EMAIL=admin@local.test
