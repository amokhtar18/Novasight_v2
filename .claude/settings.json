{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "includeCoAuthoredBy": true,
  "permissions": {
    "allow": [
      "Bash(uv run:*)",
      "Bash(pnpm:*)",
      "Bash(pytest:*)",
      "Bash(ruff:*)",
      "Bash(mypy:*)",
      "Bash(dbt:*)",
      "Bash(dagster:*)",
      "Bash(docker compose:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Read",
      "Edit",
      "Write",
      "Grep",
      "Glob"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(rm -rf:*)",
      "Bash(docker compose down -v:*)",
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./**/secrets/**)"
    ],
    "ask": [
      "Bash(docker compose down:*)",
      "Bash(alembic:*)"
    ]
  },
  "model": "opus",
  "enabledPlugins": {
    "superpowers@superpowers-dev": true
  }
}
