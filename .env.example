# NovaSight configuration — copy to .env and fill in. NEVER commit a real .env.
# Secrets here are placeholders only. Nested vars use a double-underscore delimiter.

# --- App ---
ENVIRONMENT=local            # local | onprem | cloud
LOG_LEVEL=INFO
DEFAULT_PAGE_SIZE=50
MAX_QUERY_ROWS=100000
MAX_UPLOAD_MB=100

# --- Postgres (control plane / tenant registry) ---
POSTGRES__HOST=localhost
POSTGRES__PORT=5432
POSTGRES__USER=novasight
POSTGRES__PASSWORD=change-me
POSTGRES__DB=control_plane

# --- Redis (cache + task queue) ---
REDIS__HOST=localhost
REDIS__PORT=6379
REDIS__DB=0

# --- Object store (S3-compatible: MinIO on-prem, S3/GCS in cloud) ---
OBJECT_STORE__ENDPOINT_URL=http://localhost:9000   # leave blank for AWS S3
OBJECT_STORE__REGION=us-east-1
OBJECT_STORE__ACCESS_KEY=minio
OBJECT_STORE__SECRET_KEY=change-me8                 # MinIO requires >= 8 chars
OBJECT_STORE__BUCKET=novasight

# --- Iceberg REST catalog ---
ICEBERG__CATALOG_URI=http://localhost:8181
ICEBERG__WAREHOUSE=s3://novasight/warehouse
# ICEBERG__CATALOG_TOKEN=change-me   # optional; omit for unauthenticated catalogs

# --- ClickHouse (serving engine) ---
CLICKHOUSE__HOST=localhost
CLICKHOUSE__PORT=8123
CLICKHOUSE__USER=default
CLICKHOUSE__PASSWORD=change-me

# --- AI layer (provider-agnostic; tenants may override the model) ---
AI__PROVIDER=anthropic
AI__MODEL=your-model-id
AI__API_KEY=change-me
AI__TEMPERATURE=0.0
AI__MAX_TOKENS=1024
AI__PROMPT_TEMPLATE_DIR=./app/ai/prompts

# --- Auth ---
# Default: password mode — the backend issues + verifies HS256 tokens and serves
# /auth/login. Set a long random AUTH__SESSION_SECRET. To use an external IdP
# instead, leave AUTH__SESSION_SECRET blank and fill the OIDC block below.
AUTH__SESSION_SECRET=change-me-to-a-long-random-secret-32+chars
# AUTH__ACCESS_TTL_SECONDS=3600
# AUTH__REFRESH_TTL_SECONDS=1209600
# OIDC mode (only when AUTH__SESSION_SECRET is blank):
# AUTH__OIDC_ISSUER=https://auth.example.com/realms/novasight
# AUTH__OIDC_AUDIENCE=novasight-api
# AUTH__JWKS_URL=https://auth.example.com/realms/novasight/protocol/openid-connect/certs

# --- Seed/bootstrap tenant (created by `python -m app.scripts.seed`) ---
# On-prem single-tenant installs serve this tenant; the slug derives the tenant's
# Iceberg namespace / ClickHouse db / dbt schema. Slug: lowercase, [a-z0-9_], 2-63 chars.
SEED_TENANT__SLUG=local
SEED_TENANT__NAME=Local Tenant
SEED_TENANT__ADMIN_EMAIL=admin@example.com
# Admin password (password mode): grants login + platform-admin/superuser roles.
SEED_TENANT__ADMIN_PASSWORD=change-me-strong-admin-password

# --- dbt transform (data-platform/dbt; reuses CLICKHOUSE__* for the connection) ---
# Consumed by dbt/Dagster, NOT the backend Settings object. DBT_SCHEMA and
# DBT_PHASE1_DATASET_TABLE are tenant/runtime data — Dagster sets them per run from the
# resolved tenant context. Values below are dev placeholders for the seed tenant
# (slug `local` -> schema `tenant_local`).
DBT_SCHEMA=tenant_local
# DBT_PHASE1_DATASET_TABLE=dataset_<uuid_hex>   # required for `dbt build`; the table Phase 1 registered
DBT_THREADS=4

# --- Cube semantic layer ---
# CUBE__BASE_URL: URL the backend (FastAPI) uses to reach Cube's load endpoint.
#   In the local Docker Compose stack this is http://localhost:<CUBE__PORT>.
#   In cloud deployments it points at the Cube service DNS name / load balancer.
#   The backend reads this via CubeSettings.base_url (app/core/config.py).
CUBE__BASE_URL=http://localhost:4000

# CUBE__API_SECRET: HS256 shared secret.  The backend signs per-tenant JWTs with
#   this value; Cube verifies them.  Use a cryptographically random string of at
#   least 32 characters.  Never commit a real value here.
CUBE__API_SECRET=change-me-use-a-random-32-char-string

# CUBE__PORT: host-published port for the Cube HTTP API (container-internal: 4000).
#   Must match the port in CUBE__BASE_URL.
CUBE__PORT=4000

# SERVING_REGIONAL_SALES_TABLE: physical name of the serving table in each tenant's
#   ClickHouse database, written by the Dagster serving asset and read by the Cube
#   data model.  Change only if you need to rename the serving surface across all
#   tenants without a code change.  Must match the value Dagster sees (same env var).
SERVING_REGIONAL_SALES_TABLE=serving_regional_sales

# --- Local stack (Docker Compose only) ---
# Host publish ports for the dev containers. Container-internal ports are fixed;
# these only control what is exposed on the host. The app reaches each service via
# the *__HOST/*__PORT (and OBJECT_STORE__ENDPOINT_URL) values above.
# Postgres / Redis / ClickHouse-HTTP host ports reuse POSTGRES__PORT / REDIS__PORT /
# CLICKHOUSE__PORT. MinIO needs its own two ports (the S3 API port must match the
# port inside OBJECT_STORE__ENDPOINT_URL):
MINIO__API_PORT=9000          # S3 API — keep in sync with OBJECT_STORE__ENDPOINT_URL
MINIO__CONSOLE_PORT=9001      # MinIO web console

# Application / frontend host ports (all have safe defaults; override to taste).
# The frontend serves the SPA AND reverse-proxies /api, so it is the single origin
# you open in a browser. Open http://localhost:${FRONTEND__PORT} and sign in.
API__PORT=8000                # FastAPI (also reachable directly; the SPA proxies it)
DAGSTER__PORT=3000            # Dagster webserver (superuser orchestration UI)
FRONTEND__PORT=8080           # NovaSight web app — open this in your browser

# Backend↔Dagster control plane (launch/reload over GraphQL). The compose stack
# sets this to the in-network endpoint automatically; set it here only for non-compose
# runs. Empty disables backend-driven runs/schedules.
# DAGSTER__GRAPHQL_URL=http://localhost:3000/graphql
